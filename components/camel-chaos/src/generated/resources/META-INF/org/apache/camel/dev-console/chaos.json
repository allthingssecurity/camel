{
  "console": {
    "kind": "console",
    "group": "camel",
    "name": "chaos",
    "title": "Chaos",
    "description": "Inject faults (dev\/test only) and report how the routes coped",
    "deprecated": false,
    "readOnly": false,
    "javaType": "org.apache.camel.chaos.ChaosDevConsole",
    "groupId": "org.apache.camel",
    "artifactId": "camel-chaos",
    "version": "4.24.0-SNAPSHOT"
  },
  "options": {
    "action": {
      "index": 0,
      "kind": "option",
      "displayName": "Action",
      "group": "query",
      "label": "query",
      "required": false,
      "type": "string",
      "javaType": "java.lang.String",
      "deprecated": false,
      "autowired": false,
      "secret": false,
      "defaultValue": "report",
      "description": "What to do: report (default), add, remove, clear, reset"
    },
    "calls": {
      "index": 1,
      "kind": "option",
      "displayName": "Calls",
      "group": "query",
      "label": "query",
      "required": false,
      "type": "integer",
      "javaType": "java.lang.Long",
      "deprecated": false,
      "autowired": false,
      "secret": false,
      "description": "The rule applies to the next N matching calls, then ends (0 = no limit)"
    },
    "delay": {
      "index": 2,
      "kind": "option",
      "displayName": "Delay",
      "group": "query",
      "label": "query",
      "required": false,
      "type": "integer",
      "javaType": "java.lang.Long",
      "deprecated": false,
      "autowired": false,
      "secret": false,
      "description": "Latency to add in millis (latency rule)"
    },
    "duration": {
      "index": 3,
      "kind": "option",
      "displayName": "Duration",
      "group": "query",
      "label": "query",
      "required": false,
      "type": "integer",
      "javaType": "java.lang.Long",
      "deprecated": false,
      "autowired": false,
      "secret": false,
      "description": "Rule lifetime in millis (0 = until removed or calls reached)"
    },
    "exception": {
      "index": 4,
      "kind": "option",
      "displayName": "Exception",
      "group": "query",
      "label": "query",
      "required": false,
      "type": "string",
      "javaType": "java.lang.String",
      "deprecated": false,
      "autowired": false,
      "secret": false,
      "description": "Exception class to throw (fail rule); needs a String constructor"
    },
    "id": {
      "index": 5,
      "kind": "option",
      "displayName": "Id",
      "group": "query",
      "label": "query",
      "required": false,
      "type": "string",
      "javaType": "java.lang.String",
      "deprecated": false,
      "autowired": false,
      "secret": false,
      "description": "Rule id (add: optional, remove: required)"
    },
    "message": {
      "index": 6,
      "kind": "option",
      "displayName": "Message",
      "group": "query",
      "label": "query",
      "required": false,
      "type": "string",
      "javaType": "java.lang.String",
      "deprecated": false,
      "autowired": false,
      "secret": false,
      "description": "Exception message (fail rule)"
    },
    "pattern": {
      "index": 7,
      "kind": "option",
      "displayName": "Pattern",
      "group": "query",
      "label": "query",
      "required": false,
      "type": "string",
      "javaType": "java.lang.String",
      "deprecated": false,
      "autowired": false,
      "secret": false,
      "description": "Endpoint pattern for fail and latency rules (wildcard or regex, as in intercept)"
    },
    "probability": {
      "index": 8,
      "kind": "option",
      "displayName": "Probability",
      "group": "query",
      "label": "query",
      "required": false,
      "type": "number",
      "javaType": "java.lang.Double",
      "deprecated": false,
      "autowired": false,
      "secret": false,
      "defaultValue": 1.0,
      "description": "Probability (0..1) that a matching call gets the fault"
