    "routeId": {
      "index": 9,
      "kind": "option",
      "displayName": "Route Id",
      "group": "query",
      "label": "query",
      "required": false,
      "type": "string",
      "javaType": "java.lang.String",
      "deprecated": false,
      "autowired": false,
      "secret": false,
      "description": "Route id for a stall rule"
    },
    "type": {
      "index": 10,
      "kind": "option",
      "displayName": "Type",
      "group": "query",
      "label": "query",
      "required": false,
      "type": "string",
      "javaType": "java.lang.String",
      "deprecated": false,
      "autowired": false,
      "secret": false,
      "defaultValue": "fail",
      "description": "Rule type for add: fail, latency, stall"
    }
  }
}

